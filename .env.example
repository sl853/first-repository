PORT=3000

# Leave blank for local SQLite. Set this on Render/hosting to use Postgres.
DATABASE_URL=
PGSSLMODE=require

# Optional. Required only for screenshot/photo extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keep false in production so the app only shows real/imported listings.
SEED_SAMPLE_DEALS=false
