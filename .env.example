PORT=3003

# Hosted model path.
# Use this on Render or any hosted deploy where local Ollama is not available.
OPENAI_API_KEY=
DISABLE_OPENAI=false

# Optional live research provider for Scout.
# Tavily free tier currently includes 1,000 monthly credits.
TAVILY_API_KEY=

# Local model path.
# Install Ollama, run `ollama pull llama3.2:3b`, then leave this URL as-is for local use.
# For a hosted deploy, set this to a remote model server instead of localhost.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional private gate for /brain.
PRIVATE_SITE_PASSWORD=
PRIVATE_SITE_SESSION_SECRET=
