PORT=3003

# Hosted model path.
# Add a real key here or set it in your shell before starting the server.
OPENAI_API_KEY=

# Local model path.
# Install Ollama, run `ollama pull llama3.2:3b`, then leave this URL as-is.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional private gate for /brain.
PRIVATE_SITE_PASSWORD=
PRIVATE_SITE_SESSION_SECRET=
